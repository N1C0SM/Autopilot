# Autopilot — plantilla de variables de entorno
#
# Copia este archivo a `.env` (no se trackea en git) y rellena los valores.
# Para desarrollo normal basta con las variables SUPABASE: no se necesitan
# secretos de servidor para arrancar `npm run dev`.

# --- Supabase (claves públicas / anon; se exponen al cliente) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<supabase-anon-key>"

# Vite expone sólo las variables prefijadas con VITE_ al bundle del cliente.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Feature flags iOS (opcionales) ---
# VITE_APPLE_SIGNIN_CONFIGURED="false"  # Pon a "true" cuando el provider Apple esté configurado en Supabase.
