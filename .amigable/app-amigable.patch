+                        .padding(.horizontal, 16).frame(minHeight: 50)
+                        .overlay(alignment: .bottom) { if i < s.exercises.count - 1 { Palette.separator.frame(height: 0.5).padding(.leading, 16) } }
+                        .accessibilityElement(children: .combine)
+                    }
