+
+    var body: some View {
+        let s = sample
+        let n = weight.flatMap { MacroEstimate.estimate(weight: $0, sex: nil, goal: goal) }
+        VStack(alignment: .leading, spacing: 32) {
+            VStack(alignment: .leading, spacing: 8) {
